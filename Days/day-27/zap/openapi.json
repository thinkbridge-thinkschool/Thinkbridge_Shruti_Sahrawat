          {
            "name": "idempotencyKey",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/resilience/stats": {
      "get": {
        "tags": [
          "QuotesApi"
        ],
        "operationId": "ResilienceStats",
