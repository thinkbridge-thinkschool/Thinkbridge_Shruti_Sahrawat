  },
  "components": {
    "schemas": {
      "CreateCollectionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          }
        }
      },
      "CreateQuoteRequest": {
        "required": [
          "author",
          "text"
        ],
        "type": "object",
        "properties": {
          "author": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "text": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 3,
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 3,
            "type": "string"
          },
          "password": {
            "maxLength": 72,
            "minLength": 8,
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "description": "Paste the access token from POST /api/auth/login.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "QuotesApi"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Quotes"
    },
    {
      "name": "Collections"
    }
  ]
}