  },
  "servers": [
    {
      "url": "http://localhost:5067/"
    }
  ],
  "paths": {
    "/api/profiling/author-stats-slow": {
      "get": {
        "tags": [
          "QuotesApi"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/profiling/author-stats-fast": {
      "get": {
        "tags": [
          "QuotesApi"
        ],
