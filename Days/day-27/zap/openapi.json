      "get": {
        "tags": [
          "QuotesApi"
        ],
        "operationId": "UpstreamStatus",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/upstream/submit": {
      "post": {
        "tags": [
          "QuotesApi"
        ],
        "operationId": "UpstreamSubmit",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/upstream/mode/{mode}": {
      "post": {
        "tags": [
          "QuotesApi"
        ],
        "operationId": "SetUpstreamMode",
        "parameters": [
          {
            "name": "mode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slowDelaySeconds",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/upstream/state": {
      "get": {
        "tags": [
          "QuotesApi"
        ],
        "operationId": "UpstreamState",
