              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCollectionDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCollectionDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Collections"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Collections/{id}/items/{quoteId}": {
      "post": {
        "tags": [
