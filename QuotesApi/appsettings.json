{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Debug"
      }
    }
  },
  "AllowedHosts": "*",
  "Resilience": {
    "BaseAddress": "http://localhost:5067/api/upstream/",
    "MaxConcurrentCalls": 8,
    "QueueLimit": 0,
    "TotalRequestTimeout": "00:00:08",
    "AttemptTimeout": "00:00:02",
    "MaxRetryAttempts": 3,
    "RetryBaseDelay": "00:00:00.200",
    "FailureRatio": 0.5,
    "SamplingDuration": "00:00:30",
    "MinimumThroughput": 20,
    "BreakDuration": "00:00:05"
  },
  "Cache": {
    "Enabled": true,
    "RedisConnectionString": "",
    "Expiration": "00:05:00",
    "LocalCacheExpiration": "00:00:30"
  },
  "Jwt": {
    "Issuer": "QuotesApi",
    "Audience": "QuotesApi"
  },
  "Auth": {
    "AdminEmails": []
  }
}
