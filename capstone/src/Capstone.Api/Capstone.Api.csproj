<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The composition root, and the only project in the solution permitted to
    reference an Infrastructure assembly. Every other project references
    abstractions or another module's Contracts. Capstone.ArchitectureTests
    enforces that; this comment only explains it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Modules\Catalog\Capstone.Catalog.Infrastructure\Capstone.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Curation\Capstone.Curation.Application\Capstone.Curation.Application.csproj" />
    <ProjectReference Include="..\Modules\Curation\Capstone.Curation.Infrastructure\Capstone.Curation.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Sharing\Capstone.Sharing.Application\Capstone.Sharing.Application.csproj" />
    <ProjectReference Include="..\Modules\Sharing\Capstone.Sharing.Infrastructure\Capstone.Sharing.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Design-time only, and required here rather than only in the project that
    owns CurationDbContext: `dotnet ef` builds and inspects the STARTUP
    project, so the tools look for this package on Capstone.Api even when
    migrations are written into Capstone.Curation.Infrastructure. The
    Infrastructure copy carries PrivateAssets=all - correctly, since a
    design-time tool is not something dependents should inherit - which is
    exactly why it does not satisfy the tooling from over there.

    PrivateAssets=all here too: this is a build-time tool, and it must not
    end up as a runtime dependency of the published container image.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
